# Copy to .env and fill in real values. Never commit the real .env file.
# groundrule.txt §7 flags secrets management as still-plaintext/local-dev-only —
# this follows that same pattern for now.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=appointment_db
DB_USER=app_user
DB_PASSWORD=secure_pass

# Generate with: openssl rand -base64 32
# Must decode to >= 32 bytes — JwtTokenService checks this at startup and
# refuses to start otherwise.
JWT_SECRET=

JWT_EXPIRATION_SECONDS=3600
